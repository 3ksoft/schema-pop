{
    "name": "integration-test-project",
    "type": "module",
    "packageManager": "bun@1.3.3",
    "workspaces": [
        "packages/schema",
        "packages/bf",
        "packages/cpp",
        "packages/rust",
        "packages/ts",
        "packages/zig"
    ],
    "scripts": {
        "generate": "bun run --filter '*-schema' generate",
        "build": "bun scripts/build.ts",
        "dev": "bun scripts/build.ts --watch",
        "test": "bun run build && bun run --filter typescript test"
    },
    "devDependencies": {
        "@types/bun": "latest"
    }
}
