exports[`wgsl exporter — bitfields sub-byte fields expand to u32 struct fields with word-packed helpers 1`] = `
"struct Flags {
	a: u32,
	b: u32,
	c: u32,
};



// ==========================================
// MEMORY HELPERS (Storage Buffers interop)
// ==========================================

fn unpack_words_to_flags(raw: u32) -> Flags {
	var out: Flags;
	out.a = u32(extractBits(raw, 0u, 1u));
	out.b = u32(extractBits(raw, 1u, 3u));
	out.c = u32(extractBits(raw, 4u, 4u));
	return out;
}

fn unpack_flags(raw: u32) -> Flags {
	return unpack_words_to_flags(raw);
}

fn pack_flags_to_words(unpacked: Flags) -> u32 {
	var out: u32 = 0u;
	out = insertBits(out, u32(unpacked.a), 0u, 1u);
	out = insertBits(out, u32(unpacked.b), 1u, 3u);
	out = insertBits(out, u32(unpacked.c), 4u, 4u);
	return out;
}

fn pack_flags(unpacked: Flags) -> u32 {
	return pack_flags_to_words(unpacked);
}

"
`;

exports[`wgsl exporter — bitfields fields spanning two bytes still round-trip through pack/unpack helpers 1`] = `
"struct Wide {
	x: u32,
	y: u32,
};



// ==========================================
// MEMORY HELPERS (Storage Buffers interop)
// ==========================================

fn unpack_words_to_wide(raw: u32) -> Wide {
	var out: Wide;
	out.x = u32(extractBits(raw, 0u, 5u));
	out.y = u32(extractBits(raw, 8u, 5u));
	return out;
}

fn unpack_wide(raw: u32) -> Wide {
	return unpack_words_to_wide(raw);
}

fn pack_wide_to_words(unpacked: Wide) -> u32 {
	var out: u32 = 0u;
	out = insertBits(out, u32(unpacked.x), 0u, 5u);
	out = insertBits(out, u32(unpacked.y), 8u, 5u);
	return out;
}

fn pack_wide(unpacked: Wide) -> u32 {
	return pack_wide_to_words(unpacked);
}

"
`;
