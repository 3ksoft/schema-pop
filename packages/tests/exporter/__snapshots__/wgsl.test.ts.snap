// Bun Snapshot v1, https://bun.sh/docs/test/snapshots

exports[`wgsl exporter — struct shape tagged union of differently-sized structs lowers to a word-array alias 1`] = `
"const SMB_obstacle: u32 = 0u;
const SMB_zone: u32 = 1u;

alias GameObjectTag = u32;
const GameObjectTag_Obstacle: GameObjectTag = 0u;
const GameObjectTag_Zone: GameObjectTag = 1u;

struct Zone {
	bounds: vec4<f32>,
};

const ZONE_BOUNDS_LEN: u32 = 4u;

struct Obstacle {
	pos: vec2<f32>,
	rotation: f32,
	material: u32,
	enabled: u32,
	static: u32,
	round: u32,
};

const OBSTACLE_POS_LEN: u32 = 2u;

alias GameObject = array<u32, 12>;


// ==========================================
// MEMORY HELPERS (Storage Buffers interop)
// ==========================================

fn unpack_words_to_zone(raw: array<u32, 4>) -> Zone {
	var out: Zone;
	out.bounds = vec4<f32>(bitcast<f32>(raw[0u + 0u]), bitcast<f32>(raw[0u + 1u]), bitcast<f32>(raw[0u + 2u]), bitcast<f32>(raw[0u + 3u]));
	return out;
}

fn unpack_zone(raw: array<u32, 4>) -> Zone {
	return unpack_words_to_zone(raw);
}

fn pack_zone_to_words(unpacked: Zone) -> array<u32, 4> {
	var out: array<u32, 4>;
	for (var w = 0u; w < 4u; w++) { out[w] = 0u; }
	out[0u + 0u] = bitcast<u32>(unpacked.bounds.x);
		out[0u + 1u] = bitcast<u32>(unpacked.bounds.y);
		out[0u + 2u] = bitcast<u32>(unpacked.bounds.z);
		out[0u + 3u] = bitcast<u32>(unpacked.bounds.w);
			return out;
}

fn pack_zone(unpacked: Zone) -> array<u32, 4> {
	return pack_zone_to_words(unpacked);
}

fn unpack_words_to_obstacle(raw: array<u32, 6>) -> Obstacle {
	var out: Obstacle;
	out.pos = vec2<f32>(bitcast<f32>(raw[0u + 0u]), bitcast<f32>(raw[0u + 1u]));
	out.rotation = bitcast<f32>(raw[2u]);
		out.enabled = u32(extractBits(raw[4u], 0u, 8u));
	out.static = u32(extractBits(raw[4u], 8u, 8u));
	out.round = u32(extractBits(raw[4u], 16u, 8u));
	return out;
}

fn unpack_obstacle(raw: array<u32, 6>) -> Obstacle {
	return unpack_words_to_obstacle(raw);
}

fn pack_obstacle_to_words(unpacked: Obstacle) -> array<u32, 6> {
	var out: array<u32, 6>;
	for (var w = 0u; w < 6u; w++) { out[w] = 0u; }
	out[0u + 0u] = bitcast<u32>(unpacked.pos.x);
		out[0u + 1u] = bitcast<u32>(unpacked.pos.y);
			out[2u] = bitcast<u32>(unpacked.rotation);
		out[4u] = insertBits(out[4u], u32(unpacked.enabled), 0u, 8u);
	out[4u] = insertBits(out[4u], u32(unpacked.static), 8u, 8u);
	out[4u] = insertBits(out[4u], u32(unpacked.round), 16u, 8u);
	return out;
}

fn pack_obstacle(unpacked: Obstacle) -> array<u32, 6> {
	return pack_obstacle_to_words(unpacked);
}

fn get_game_object_tag(val: array<u32, 12>) -> u32 {
	return extractBits(val[0u], 0u, 8u);
}

fn unpack_game_object_as_obstacle(val: array<u32, 12>) -> Obstacle {
	var tmp: array<u32, 6>;
	for (var w = 0u; w < 6u; w++) {
		tmp[w] = val[w + 4u];
	}
	return unpack_words_to_obstacle(tmp);
}

fn pack_game_object_from_obstacle(unpacked: Obstacle) -> array<u32, 12> {
	var out: array<u32, 12>;
	for (var w = 0u; w < 12u; w++) { out[w] = 0u; }
	let tmp = pack_obstacle_to_words(unpacked);
	for (var w = 0u; w < 6u; w++) {
		out[w + 4u] = tmp[w];
	}
	out[0u] = insertBits(out[0u], 0u, 0u, 8u);
	return out;
}

fn unpack_game_object_as_zone(val: array<u32, 12>) -> Zone {
	var tmp: array<u32, 4>;
	for (var w = 0u; w < 4u; w++) {
		tmp[w] = val[w + 4u];
	}
	return unpack_words_to_zone(tmp);
}

fn pack_game_object_from_zone(unpacked: Zone) -> array<u32, 12> {
	var out: array<u32, 12>;
	for (var w = 0u; w < 12u; w++) { out[w] = 0u; }
	let tmp = pack_zone_to_words(unpacked);
	for (var w = 0u; w < 4u; w++) {
		out[w + 4u] = tmp[w];
	}
	out[0u] = insertBits(out[0u], 1u, 0u, 8u);
	return out;
}

"
`;

exports[`wgsl exporter — padding std430 struct with alignment gap emits the referenced type name 1`] = `
"struct S {
	tag: f32,
	v: vec4<f32>,
};

const S_V_LEN: u32 = 4u;


// ==========================================
// MEMORY HELPERS (Storage Buffers interop)
// ==========================================

fn unpack_words_to_s(raw: array<u32, 5>) -> S {
	var out: S;
	out.tag = bitcast<f32>(raw[0u]);
	out.v = vec4<f32>(bitcast<f32>(raw[1u + 0u]), bitcast<f32>(raw[1u + 1u]), bitcast<f32>(raw[1u + 2u]), bitcast<f32>(raw[1u + 3u]));
	return out;
}

fn unpack_s(raw: array<u32, 5>) -> S {
	return unpack_words_to_s(raw);
}

fn pack_s_to_words(unpacked: S) -> array<u32, 5> {
	var out: array<u32, 5>;
	for (var w = 0u; w < 5u; w++) { out[w] = 0u; }
	out[0u] = bitcast<u32>(unpacked.tag);
	out[1u + 0u] = bitcast<u32>(unpacked.v.x);
		out[1u + 1u] = bitcast<u32>(unpacked.v.y);
		out[1u + 2u] = bitcast<u32>(unpacked.v.z);
		out[1u + 3u] = bitcast<u32>(unpacked.v.w);
			return out;
}

fn pack_s(unpacked: S) -> array<u32, 5> {
	return pack_s_to_words(unpacked);
}

"
`;

