{
	"compilerOptions": {
		"target": "esnext",
		"lib": ["esnext", "dom"],
		"module": "esnext",
		"moduleResolution": "bundler",
		"strict": true,
		"paths": {
			"@schema-pop/schema": ["../schema/src/index.ts"],
			"@schema-pop/exporter": ["../exporter/src/index.ts"],
			"@schema-pop/importer": ["../importer/src/index.ts"]
		}
	},
	"include": ["**/*.ts", "**/*.tsx"]
}
