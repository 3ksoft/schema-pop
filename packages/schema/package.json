{
	"name": "@schema-pop/schema",
	"version": "0.2.0",
	"type": "module",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"bun:main": "./src/index.ts",
	"types": "./dist/index.d.ts",
	"files": [
		"src"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "rm -rf dist && bun build ./src/index.ts --outdir ./dist --target node --packages external && tsgo --declaration --emitDeclarationOnly --outDir dist --noEmit false",
		"typecheck": "tsgo --noEmit",
		"test": "bun test"
	},
	"dependencies": {
		"arkregex": "^0.0.5",
		"arktype": "2.2.0",
		"@ark/schema": "0.56.0"
		
	},
	"devDependencies": {
		"typescript": "^6.0.3"
	}
}
