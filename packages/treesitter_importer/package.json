{
	"name": "@schema-pop/treesitter-importer",
	"version": "0.1.0-experimental.0",
	"private": true,
	"type": "module",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"bun:main": "./src/index.ts",
	"types": "./dist/index.d.ts",
	"bin": {
		"schema-pop-import": "./src/cli.ts",
		"schema-pop-import-rust": "./src/cli.ts"
	},
	"files": [
		"dist",
		"src",
		"wasm"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "rm -rf dist && bun build ./src/index.ts --outdir ./dist --target node --packages external && tsc --declaration --emitDeclarationOnly --outDir dist --noEmit false",
		"typecheck": "tsc --noEmit",
		"test": "bun test"
	},
	"dependencies": {
		"schema-pop": "workspace:*",
		"web-tree-sitter": "^0.25.0"
	}
}
