{
	"compilerOptions": {
		"module": "esnext",
		"target": "es2023",
		"lib": ["ES2023"],
		"types": ["node"],
		"skipLibCheck": true,
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"moduleDetection": "force",
		"noEmit": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"erasableSyntaxOnly": true,
		"noFallthroughCasesInSwitch": true,
		"strict": true,
		"rootDir": "src/"
	},
	"include": ["src"],
	"exclude": ["src/**/*.test.ts"]
}
