{
	"name": "schema-pop",
	"version": "0.1.23",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./node": {
			"types": "./dist/node.d.ts",
			"default": "./dist/node.js"
		}
	},
	"bin": {
		"schema-pop": "./dist/cli.js"
	},
	"scripts": {
		"build": "rm -rf dist && bun build ./src/index.ts ./src/cli.ts ./src/node.ts --outdir ./dist --target node --packages external && tsc --declaration --emitDeclarationOnly --outDir dist --noEmit false",
		"typecheck": "tsc --noEmit",
		"test": "bun test",
		"bench": "bun run src/codec/pop.bench.ts"
	},
	"dependencies": {
		"arktype": "2.2.0",
		"@ark/schema": "0.56.0",
		"jiti": "2.6.1"
	},
	"devDependencies": {
		"typescript": "6.0.3",
		"@types/node": "25.6.0",
		"@types/bun": "1.1.13"
	}
}
