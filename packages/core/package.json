{
	"name": "@schema-pop/core",
	"version": "0.2.0",
	"type": "module",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"bun:main": "./src/index.ts",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"src",
		"!src/engine"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "rm -rf dist && bun build ./src/index.ts --outdir ./dist --target node --packages external && tsc --declaration --emitDeclarationOnly --outDir dist --noEmit false",
		"typecheck": "tsc --noEmit",
		"test": "bun test"
	},
	"dependencies": {
		"@schema-pop/schema": "workspace:*",
		"@ark/schema": "0.56.0",
		"arktype": "2.2.0"
	},
	"devDependencies": {
		"@types/node": "^25.6.0",
		"@types/bun": "^1.3.13",
		"typescript": "^6.0.3"
	}
}
