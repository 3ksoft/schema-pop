{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"outDir": "./dist",
		"rootDir": "./src",
		"tsBuildInfoFile": "./dist/tsconfig.tsbuildinfo",
		"noUnusedLocals": false,
		"noUnusedParameters": false
	},
	"include": [
		"src/**/*",
	],
	"exclude": [
		"src/engine/**/*",
		"node_modules",
		"dist"
	],
	"references": [
		{
			"path": "../schema"
		}
	]
}