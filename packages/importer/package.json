{
	"name": "@schema-pop/importer",
	"version": "0.2.0",
	"description": "Import into schema-pop",
	"type": "module",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"bun:main": "./src/index.ts",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"src",
		"wasm"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./kaitai": {
			"types": "./src/kaitai.ts",
			"default": "./src/kaitai.ts"
		}
	},
	"scripts": {
		"build": "rm -rf dist && bun build ./src/index.ts --outdir ./dist --target node --packages external && tsgo --declaration --emitDeclarationOnly --outDir dist --noEmit false",
		"build:wasm": "bash ./scripts/build-wasm.sh",
		"build:gimli": "bash ./scripts/build-gimli.sh",
		"typecheck": "tsgo --noEmit",
		"test": "bun test"
	},
	"dependencies": {
		"@schema-pop/schema": "workspace:*",
		"@types/xml2js": "^0.4.14",
		"web-tree-sitter": "^0.26.8",
		"xml2js": "^0.6.2",
		"yaml": "^2.8.1"
	}
}
